{
    "name": "edumicro/daisyblade",
    "description": "Pure Blade + Alpine.js UI components for Laravel ERP/CRM. DaisyUI styled.",
    "keywords": ["laravel", "blade", "alpinejs", "daisyui", "tailwind", "components"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "edumicro",
            "homepage": "https://github.com/edumicro"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "blade-ui-kit/blade-heroicons": "^2.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "orchestra/testbench": "^10.9",
        "pestphp/pest-plugin-browser": "^4.3"
    },
    "suggest": {
        "maatwebsite/excel": "Required by the daisyblade import/spreadsheet component (^3.1)"
    },
    "autoload": {
        "psr-4": {
            "Edumicro\\DaisyBlade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edumicro\\DaisyBlade\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:php",
            "@test:browser",
            "@test:js"
        ],
        "test:php": "vendor/bin/pest --testsuite=Unit,Feature",
        "test:browser": "vendor/bin/pest --testsuite=Browser",
        "test:js": "node --test tests/js/*.test.mjs"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edumicro\\DaisyBlade\\DaisyBladeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
